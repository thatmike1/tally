[Unit]
Description=sample the Claude account usage meters every 5 minutes

[Timer]
# wall-clock, not OnBootSec + OnUnitActiveSec: the user manager starts after
# login, past OnBootSec, and OnUnitActiveSec needs an activation this manager
# has not seen yet, so that pair never fired again after a reboot or re-login
OnCalendar=*:0/5
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
